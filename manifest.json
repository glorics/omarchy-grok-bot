{
  "schemaVersion": 1,
  "id": "glorics.grok-bot",
  "name": "Grok Bot",
  "version": "1.12.1",
  "author": "glorics",
  "license": "MIT",
  "description": "Unofficial Omarchy bar widget for the Grok Bot Linux client. Themed x.ai/bot face, launch/focus, status, and optional Cursor CDN updates.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Grok Bot",
    "description": "One bar icon: themed x.ai/bot mascot, client status, and optional CDN updates.",
    "category": "AI",
    "aliases": ["grok-bot", "grokbot"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 15
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
