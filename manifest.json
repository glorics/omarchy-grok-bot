{
  "schemaVersion": 1,
  "id": "glorics.grok-bot",
  "name": "Grok Bot",
  "version": "1.4.0",
  "author": "glorics",
  "license": "MIT",
  "description": "Launch and focus the official Grok Bot Linux client from the Omarchy bar. The mark looks around and blinks while the client is open.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Grok Bot",
    "description": "One bar icon: running state and launch-or-focus for the official Linux AppImage.",
    "category": "AI",
    "aliases": ["grok-bot", "grokbot", "cockbot"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 15
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
